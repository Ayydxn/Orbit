{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "sources": "${sources_url}",
    "issues": "${issue_tracker_url}"
  },
  "license": "${license}",
  "icon": "assets/${mod_id}/${icon_path}",
  "environment": "*",
  "entrypoints": {
    "client": [
      "me.ayydxn.orbit.fabric.OrbitClientModFabric"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_api_version}"
  }
}